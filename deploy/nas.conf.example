# /etc/ticket-manager/nas.conf  — usado por deploy/copia-nas.sh
# Copie para /etc/ticket-manager/nas.conf e ajuste. Permissões: sudo chmod 600 (só o root lê).

# Compartilhamentos do NAS (//NOME_OU_IP/compartilhamento). Podem ser o mesmo.
NAS_BACKUP=//IP_DO_NAS/cpd-backup
NAS_LOGS=//IP_DO_NAS/cpd-log

# Usuário e senha do NAS (arquivo separado, também só para o root)
NAS_CREDENCIAIS=/etc/ticket-manager/nas.cred

# Subpasta com o nome do servidor (padrão: o hostname)
# NOME_SERVIDOR=ticket-manager

# Quantos dias guardar no NAS (0 = para sempre)
RETENCAO_BACKUP_DIAS=90
RETENCAO_LOGS_DIAS=365
